# Salin ke .env.local lalu isi nilainya. JANGAN commit .env.local.
# Pembayaran (Mayar). PAYMENT_PROVIDER kosong = mayar.
PAYMENT_PROVIDER=
# Key sandbox (web.mayar.io) untuk Preview/lokal; key production (web.mayar.id) hanya untuk Production.
MAYAR_API_KEY=
# Sandbox: https://api.mayar.io  |  Production: https://api.mayar.id
MAYAR_BASE_URL=
# Mis. https://dimentoring.id (kosong = origin request, untuk Preview).
# Juga dasar tautan di email notifikasi mentor (kosong = https://dimentoring.id).
APP_BASE_URL=
# Lead Capture (kartu WhatsApp di hasil Assessment + POST /api/leads, PRD 7.4.6/BR-38).
# Aktif HANYA kalau persis "true"; kosong/nilai lain = mati. Halaman Admin /leads tetap aktif.
# Jalankan db/add_leads.sql dulu sebelum mengaktifkan.
NEXT_PUBLIC_LEAD_CAPTURE_ENABLED=

# ---- Email notifikasi (Resend) ----------------------------------------------
# Kunci Resend. Kosong = email notifikasi dilewati (satu peringatan di log, tanpa error).
RESEND_API_KEY=
# Pengirim email notifikasi mentor. Domain WAJIB sudah terverifikasi di Resend.
# Kosong = notifikasi@dimentoring.id / "Dimentoring".
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
# Alamat balasan (opsional). Kosong = tidak ada reply-to.
EMAIL_REPLY_TO=

# ---- WhatsApp notifikasi mentor (Fonnte) -------------------------------------
# Token perangkat Fonnte. HANYA di server; jangan beri awalan NEXT_PUBLIC_.
FONNTE_TOKEN=
# Kanal WhatsApp menyala HANYA kalau persis "true"; kosong/nilai lain = mati
# (nol panggilan ke Fonnte). Jalankan db/add_notifikasi_wa.sql dulu sebelum menyalakan.
WA_NOTIF_ENABLED=
# Batas pesan WhatsApp per hari (WIB). Kosong = 50.
WA_NOTIF_BATAS_HARIAN=
