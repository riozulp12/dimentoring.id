# Salin ke .env.local lalu isi nilainya. JANGAN commit .env.local.
# Pembayaran (Mayar). PAYMENT_PROVIDER kosong = mayar.
PAYMENT_PROVIDER=
# Key sandbox (web.mayar.io) untuk Preview/lokal; key production (web.mayar.id) hanya untuk Production.
MAYAR_API_KEY=
# Sandbox: https://api.mayar.io  |  Production: https://api.mayar.id
MAYAR_BASE_URL=
# Mis. https://dimentoring.id (kosong = origin request, untuk Preview)
APP_BASE_URL=
