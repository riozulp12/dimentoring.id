# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local state (per-user settings, stray agent worktrees)
.claude/settings.local.json
.claude/worktrees/

# scratch/seed scripts for local QA testing (not part of the product)
_tmp_seed_qa.mjs

# scripts/tarik-data-ptn.ts output — per-run generated data, not source
scripts/progress-ptn.json
scripts/hasil-tarik-ptn.csv
scripts/progress-ptn-luar-jawa.json
scripts/hasil-tarik-ptn-luar-jawa.csv
